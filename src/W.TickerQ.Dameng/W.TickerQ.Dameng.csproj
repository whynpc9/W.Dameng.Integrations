<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Dameng EF Core operational storage configuration for TickerQ 10.1.1.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TickerQF14 Condition="'$(TickerQF14)' == ''">true</TickerQF14>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TickerQF14)' == 'true'">
    <DefineConstants>$(DefineConstants);TICKERQ_F14</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TickerQF14)' == 'false'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(TickerQF14)' == 'true'">
    <PackageReference Include="W.TickerQ.Core" Version="[10.1.1-dameng.1]" />
    <PackageReference Include="W.TickerQ.EntityFrameworkCore" Version="[10.1.1-dameng.1]" />
    <PackageReference Include="W.TickerQ.Utilities" Version="[10.1.1-dameng.1]" />
  </ItemGroup>
  <ItemGroup Condition="'$(TickerQF14)' == 'false'">
    <PackageReference Include="TickerQ" Version="[10.1.1]" />
    <PackageReference Include="TickerQ.EntityFrameworkCore" Version="[10.1.1]" />
    <PackageReference Include="TickerQ.Utilities" Version="[10.1.1]" />
  </ItemGroup>
  <ItemGroup>
    <None Update="buildTransitive/W.TickerQ.Dameng.targets" Pack="true" PackagePath="buildTransitive/W.TickerQ.Dameng.targets" />
    <ProjectReference Include="../W.FlexLabs.Upsert.Dameng/W.FlexLabs.Upsert.Dameng.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="W.EntityFrameworkCore.Dameng" Version="[0.5.0]" />
    <PackageReference Include="W.EntityFrameworkCore.Dameng.WDriver" Version="[0.5.0-preview.1]" />
    <PackageReference Include="W.DamengProvider" Version="[0.3.1]" />
  </ItemGroup>
</Project>
