<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TickerQF14 Condition="'$(TickerQF14)' == ''">true</TickerQF14>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TickerQF14)' == 'true'">
    <DefineConstants>$(DefineConstants);TICKERQ_F14</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TickerQF14Seed)' == 'true'">
    <DefineConstants>$(DefineConstants);TICKERQ_F14_SEED</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TickerQF14Migration)' == 'true'">
    <DefineConstants>$(DefineConstants);TICKERQ_F14_MIGRATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/W.TickerQ.Dameng/W.TickerQ.Dameng.csproj" />
    <Compile Include="../../scripts/tickerq/Isolation.cs" Link="Isolation.cs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>
</Project>
